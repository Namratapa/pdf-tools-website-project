# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# File handling
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=20
OUTPUT_RETENTION_MINUTES=30

APP_ENV=development
